          "name": "v1",
          "item": [
            {
              "name": "settlement",
              "item": [
                {
                  "name": "{date}",
                  "item": [
                    {
                      "name": "Get all transactions in a daily settlement",
                      "id": "e0763a87-356c-478d-a500-b1ec7f2e7895",
                      "protocolProfileBehavior": {
                        "disableBodyPruning": true
                      },
                      "request": {
                        "method": "GET",
                        "header": [
                          {
                            "key": "Accept",
                            "value": "application/json"
                          }
                        ],
                        "url": {
                          "raw": "{{baseUrl}}/reports/v1/settlement/:date",
                          "host": [
                            "{{baseUrl}}"
                          ],
                          "path": [
                            "reports",
                            "v1",
                            "settlement",
                            ":date"
                          ],
                          "variable": [
                            {
                              "id": "d8fcabea-d225-42bf-b76b-ee8d77aec4d4",
                              "key": "date",
                              "value": "<string>",
                              "description": "(Required) Date is represented by ISO8601 \u2013 \u20182016-03-01\u2019 for 1st March 2016."
                            }
                          ]
                        },
                        "description": "You may choose to set your mAccounts to settle automatically every day. If so, the mAccount balance will be brought to zero at 4pm (Sydney time) each business day. Any positive balance will be disbursed to the bank account you have linked; any negative balance will be direct debited from the bank account you have linked. Transactions on weekends, public holidays and after 4pm won\u2019t appear in the settlement report until after 4pm the next business day.\nThis report returns an array of actual disbursements for each transaction that was settled on the given date. Date is represented by ISO8601 \u2013 \u20182016-03-01\u2019 for 1st March 2016."
                      },
                      "response": [
                        {
                          "id": "948bbeee-f2be-4cf6-85f7-62654f10ce08",
                          "name": "OK",
                          "originalRequest": {
                            "method": "GET",
                            "header": [
                              {
                                "key": "Accept",
                                "value": "application/json"
                              },
                              {
                                "description": "Added as a part of security scheme: basic",
                                "key": "Authorization",
                                "value": "Basic <credentials>"
                              }
                            ],
                            "url": {
                              "raw": "{{baseUrl}}/reports/v1/settlement/:date",
                              "host": [
                                "{{baseUrl}}"
                              ],
                              "path": [
                                "reports",
                                "v1",
                                "settlement",
                                ":date"
                              ],
                              "variable": [
                                {
                                  "key": "date"
                                }
                              ]
                            }
                          },
                          "status": "OK",
                          "code": 200,
                          "_postman_previewlanguage": "json",
                          "header": [
                            {
                              "key": "Content-Type",
                              "value": "application/json"
                            }
                          ],
                          "cookie": [],
                          "responseTime": null,
                          "body": "{\n  \"durationMs\": \"<long>\",\n  \"status\": \"<string>\",\n  \"statusDescription\": \"<string>\",\n  \"settlements\": [\n    {\n      \"uniqueReferenced\": \"<string>\",\n      \"transactionId\": \"<integer>\",\n      \"disbursementAmount\": \"<number>\",\n      \"disbursementMethod\": \"<string>\",\n      \"feeAmountExclGst\": \"<number>\",\n      \"feeAmountGstComponent\": \"<number>\",\n      \"feeAmountInclGst\": \"<number>\"\n    },\n    {\n      \"uniqueReferenced\": \"<string>\",\n      \"transactionId\": \"<integer>\",\n      \"disbursementAmount\": \"<number>\",\n      \"disbursementMethod\": \"<string>\",\n      \"feeAmountExclGst\": \"<number>\",\n      \"feeAmountGstComponent\": \"<number>\",\n      \"feeAmountInclGst\": \"<number>\"\n    }\n  ]\n}",
