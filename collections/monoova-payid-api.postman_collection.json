                  "name": "registerpayid",
                  "item": [
                    {
                      "name": "Register PayID",
                      "id": "c0c23233-d3e3-47a9-954c-56963434619d",
                      "protocolProfileBehavior": {
                        "disableBodyPruning": true
                      },
                      "request": {
                        "method": "POST",
                        "header": [
                          {
                            "key": "Content-Type",
                            "value": "application/json"
                          },
                          {
                            "key": "Accept",
                            "value": "application/json"
                          }
                        ],
                        "body": {
                          "mode": "raw",
                          "raw": "{\n  \"bankAccountNumber\": \"<string>\",\n  \"payIdName\": \"<string>\",\n  \"bsb\": \"<string>\",\n  \"payId\": \"<string>\"\n}",
                          "options": {
                            "raw": {
                              "headerFamily": "json",
                              "language": "json"
                            }
                          }
                        },
                        "url": {
                          "raw": "{{baseUrl}}/receivables/v1/payid/registerpayid",
                          "host": [
                            "{{baseUrl}}"
                          ],
                          "path": [
                            "receivables",
                            "v1",
                            "payid",
                            "registerpayid"
                          ]
                        },
                        "description": "This endpoint allows the registration of a PayID against an account number. We recommend leaving 10 seconds before registering a PayID to ensure an account number has been enabled for NPP. The domains that can be used to register a PayID are restricted. Custom domains are supported but must first be approved, please contact us for configuration. The default domain is monoova.me, if the PayID field is left blank we will generate a check-digited PayID on the Monoova domain."
                      },
