                  "item": [
                    {
                      "name": "Create OneShot security Token",
                      "id": "1fe2ba91-52ab-4c7e-a06e-e9fc7c21c58c",
                      "protocolProfileBehavior": {
                        "disableBodyPruning": true
                      },
                      "request": {
                        "method": "GET",
                        "header": [
                          {
                            "key": "Accept",
                            "value": "application/json"
                          }
                        ],
                        "url": {
                          "raw": "{{baseUrl}}/security/v1/createOneShotSecurityToken/:timeOutMin?Claims=<string>",
                          "host": [
                            "{{baseUrl}}"
                          ],
                          "path": [
                            "security",
                            "v1",
                            "createOneShotSecurityToken",
                            ":timeOutMin"
                          ],
                          "query": [
                            {
                              "description": "This is Optional. Passing a 'Token' in parameter to generate restricted Token which only allows user to create Token. Currently Available parameters are 'Admin', 'Reporting' and 'Token'",
                              "key": "Claims",
                              "value": "<string>"
                            }
                          ],
                          "variable": [
                            {
                              "id": "109ba504-1d78-4a50-ba17-568b56071b74",
                              "key": "timeOutMin",
                              "value": "<number>",
                              "description": "(Required) Each token has an expiry time between 1 and 15 minutes"
                            }
                          ]
                        },
                        "description": "This API returns a security token that can be used only once or until it expires.\nThe purpose of this token is that it can be embedded in a web form to enable you to make a single call to the Engine without exposing your Sign-In Account credentials.\nWhen setting your security credentials to call any of the APIs in this document (except for security/v1/createOneShotSecurityToken),\nset the Username to the returned OneShotSecurityToken and set the password to anything as it will be ignored."
                      },
