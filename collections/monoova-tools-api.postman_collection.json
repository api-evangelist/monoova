              "item": [
                {
                  "name": "{abnNumber}",
                  "item": [
                    {
                      "name": "Validate an ABN",
                      "id": "20a5d88f-f34c-423c-b8d5-a829f87bdbaf",
                      "protocolProfileBehavior": {
                        "disableBodyPruning": true
                      },
                      "request": {
                        "method": "GET",
                        "header": [
                          {
                            "key": "Accept",
                            "value": "application/json"
                          }
                        ],
                        "url": {
                          "raw": "{{baseUrl}}/tools/v1/abnValidate/:abnNumber",
                          "host": [
                            "{{baseUrl}}"
                          ],
                          "path": [
                            "tools",
                            "v1",
                            "abnValidate",
                            ":abnNumber"
                          ],
                          "variable": [
                            {
                              "id": "11d5e566-3c4c-44f7-941e-07b55a1a3e26",
                              "key": "abnNumber",
                              "value": "<string>",
                              "description": "(Required) ABN (Australian Business Number)"
                            }
                          ]
                        },
                        "description": "The purpose of this API is to validate that an ABN (Australian Business Number) is correct and determine if it\u2019s valid. This API makes a call to the Australian Business Registry returning current details about the company. An ABN is defined as a string of eleven numeric digits.Spaces are allowed but no other characters. If the resulting status property contains \u2018Ok\u2019 then examine the property isAbnValid. The property isCharity will be true if the entity is an active registered charity. A list of codes and more information is available at http://abr.business.gov.au/Documentation/ReferenceData"
                      },
                      "response": [
                        {
                          "id": "6ab39a2e-5d55-431e-98ee-a26428566aba",
                          "name": "OK",
                          "originalRequest": {
                            "method": "GET",
                            "header": [
                              {
                                "key": "Accept",
                                "value": "application/json"
                              },
                              {
                                "description": "Added as a part of security scheme: basic",
                                "key": "Authorization",
                                "value": "Basic <credentials>"
                              }
                            ],
                            "url": {
                              "raw": "{{baseUrl}}/tools/v1/abnValidate/:abnNumber",
                              "host": [
                                "{{baseUrl}}"
                              ],
                              "path": [
                                "tools",
                                "v1",
                                "abnValidate",
                                ":abnNumber"
                              ],
                              "variable": [
                                {
                                  "key": "abnNumber"
                                }
                              ]
                            }
                          },
                          "status": "OK",
                          "code": 200,
                          "_postman_previewlanguage": "json",
                          "header": [
                            {
                              "key": "Content-Type",
                              "value": "application/json"
                            }
                          ],
                          "cookie": [],
                          "responseTime": null,
                          "body": "{\n  \"durationMs\": \"<long>\",\n  \"status\": \"<string>\",\n  \"statusDescription\": \"<string>\",\n  \"abn\": \"<string>\",\n  \"lastUpdatedDate\": \"<string>\",\n  \"isAbnValid\": \"<boolean>\",\n  \"isCharity\": \"<boolean>\",\n  \"entityTypeCode\": \"<string>\",\n  \"entityTypeDescription\": \"<string>\",\n  \"organisationName\": \"<string>\",\n  \"legalName\": \"<string>\",\n  \"organisationNameFromDate\": \"<string>\",\n  \"businessPhysicalAddressStateCode\": \"<string>\",\n  \"businessPhysicalAddressPostCode\": \"<string>\",\n  \"businessPhysicalAddressEffectiveFromDate\": \"<string>\"\n}",
