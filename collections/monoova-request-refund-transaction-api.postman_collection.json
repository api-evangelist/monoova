                              }
                            ],
                            "body": {
                              "mode": "raw",
                              "raw": "{\n  \"clientParentTransactionUniqueReference\": \"NpbOD6_lKWfI1\",\n  \"clientTransactionUniqueReference\": \"PH81U-b1B-dJGi6wYqm\",\n  \"refundAmount\": \"<float>\",\n  \"refundReason\": \"<string>\"\n}",
                              "options": {
                                "raw": {
                                  "headerFamily": "json",
                                  "language": "json"
                                }
                              }
                            },
                            "url": {
                              "raw": "{{baseUrl}}/au/card/ccm/CreditCardTransactionAsync/refund",
                              "host": [
                                "{{baseUrl}}"
                              ],
                              "path": [
                                "au",
                                "card",
                                "ccm",
                                "CreditCardTransactionAsync",
                                "refund"
                              ]
                            },
                            "description": "This endpoint can be used to request a refund of the payment. This is an asynchronous process and can take up to 3 business days. This request can be raised for both settled and unsettled payments.\nA webhook will be initiated to notify customers about the status change.\nFor settled payments, a separate refund transaction will be created. Original payment status will not be affected. Partial refunds are supported. Multiple partial refund requests can be initiated for payment as long as the total of the refund amount does not exceed the original payment value and another refund request is not in progress for the same payment.\n\nThe status of the refund can be checked using the Credit Card - Get Transaction By Id endpoint or Credit Card - Get Async Request Status.\nWe also initiate a webhook when the refund status is finalized(Settlement Complete/Failed/Declined)."
                          },
