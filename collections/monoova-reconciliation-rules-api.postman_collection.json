                          }
                        ],
                        "body": {
                          "mode": "raw",
                          "raw": "{\n  \"reconciliationRuleReference\": \"EVkn4AXxSvtHASIsQ5mW8P-9\",\n  \"amount\": \"<double>\",\n  \"expiryDateTime\": \"<string>\",\n  \"bsb\": \"<string>\",\n  \"accountNumber\": \"<string>\",\n  \"payId\": \"<string>\"\n}",
